# Validate the deterministic legacy-debug CDC waiver XDC against an existing
# routed checkpoint. This check does not modify or republish implementation
# artifacts.
set rdma_script_dir [file dirname [file normalize [info script]]]
set rdma_project_dir [file normalize [file join $rdma_script_dir .. ..]]
set rdma_build_dir [file join $rdma_project_dir rdma build]
set rdma_routed_checkpoint [file join $rdma_build_dir vivado_rdma \
  rdma.runs rdma_impl_1 rdma_top_routed.dcp]
set rdma_check_xdc [file join $rdma_build_dir \
  rdma_legacy_debug_cdc_waivers.check.xdc]

if {![file exists $rdma_routed_checkpoint] ||
    [file size $rdma_routed_checkpoint] == 0} {
  error "Missing routed checkpoint: $rdma_routed_checkpoint"
}

set rdma_generate_check_xdc [expr {
  [llength $argv] == 0 || [lindex $argv 0] ne "reload"}]
if {$rdma_generate_check_xdc} {
open_checkpoint $rdma_routed_checkpoint

set rdma_vio_pin [get_pins -quiet -hierarchical -regexp \
  {.*i_rdma_vio/probe_out0$}]
if {[llength $rdma_vio_pin] != 1} {
  error "Expected one rdma_vio/probe_out0 pin, found [llength $rdma_vio_pin]"
}
set rdma_vio_net [get_nets -quiet -of_objects $rdma_vio_pin]
if {[llength $rdma_vio_net] != 1} {
  error "Expected one rdma_vio/probe_out0 net, found [llength $rdma_vio_net]"
}
set rdma_vio_sinks [get_pins -quiet -leaf -of_objects $rdma_vio_net \
  -filter {DIRECTION == IN}]
if {[llength $rdma_vio_sinks] == 0} {
  error "rdma_vio/probe_out0 has no implemented functional load"
}
puts "RDMA_RETRANSMISSION_VIO_CHECK pins=1 nets=1 sinks=[llength $rdma_vio_sinks]"

set rdma_legacy_drp_clock_pin [get_pins -quiet -hierarchical -regexp \
  {.*GTYE4_COMMON_PRIM_INST/DRPCLK$}]
if {[llength $rdma_legacy_drp_clock_pin] != 1} {
  error "Expected one GTYE4 DRPCLK pin, found [llength $rdma_legacy_drp_clock_pin]"
}

set rdma_legacy_cdc_sources [list]
for {set rdma_legacy_drp_bit 0} {$rdma_legacy_drp_bit < 16} \
    {incr rdma_legacy_drp_bit} {
  set rdma_legacy_drp_source [get_pins -quiet -hierarchical -regexp \
    [format {.*GTYE4_COMMON_PRIM_INST/DRPDO\[%d\]$} \
      $rdma_legacy_drp_bit]]
  if {[llength $rdma_legacy_drp_source] != 1} {
    error "Expected one GTYE4 DRPDO source for bit $rdma_legacy_drp_bit, found [llength $rdma_legacy_drp_source]"
  }
  lappend rdma_legacy_cdc_sources [lindex $rdma_legacy_drp_source 0]
}
set rdma_legacy_drprdy_source [get_pins -quiet -hierarchical -regexp \
  {.*GTYE4_COMMON_PRIM_INST/DRPRDY$}]
if {[llength $rdma_legacy_drprdy_source] != 1} {
  error "Expected one GTYE4 DRPRDY source, found [llength $rdma_legacy_drprdy_source]"
}
lappend rdma_legacy_cdc_sources [lindex $rdma_legacy_drprdy_source 0]

set rdma_legacy_cdc_sinks [list]
foreach rdma_legacy_cdc_source $rdma_legacy_cdc_sources {
  set rdma_legacy_cdc_net [get_nets -quiet -of_objects $rdma_legacy_cdc_source]
  if {[llength $rdma_legacy_cdc_net] != 1} {
    error "Expected one legacy DRP net for $rdma_legacy_cdc_source, found [llength $rdma_legacy_cdc_net]"
  }
  set rdma_legacy_cdc_drivers [get_pins -quiet -leaf \
    -of_objects $rdma_legacy_cdc_net -filter {DIRECTION == OUT}]
  if {[llength $rdma_legacy_cdc_drivers] != 1 ||
      [get_property NAME [lindex $rdma_legacy_cdc_drivers 0]] ne
      [get_property NAME $rdma_legacy_cdc_source]} {
    error "Legacy DRP net does not have its expected single driver: $rdma_legacy_cdc_net"
  }
  set rdma_legacy_cdc_sink [get_pins -quiet -leaf \
    -of_objects $rdma_legacy_cdc_net -filter {DIRECTION == IN}]
  if {[llength $rdma_legacy_cdc_sink] != 1} {
    error "Expected one ILA D sink for $rdma_legacy_cdc_net, found [llength $rdma_legacy_cdc_sink]"
  }
  set rdma_legacy_cdc_sink_name [get_property NAME $rdma_legacy_cdc_sink]
  if {![regexp {(^|/)u_ila(_[0-9]+|_status_[0-9]+)?/inst/.*/D$} \
      $rdma_legacy_cdc_sink_name]} {
    error "Legacy DRP net does not terminate at an ILA D pin: $rdma_legacy_cdc_sink_name"
  }
  lappend rdma_legacy_cdc_sinks [lindex $rdma_legacy_cdc_sink 0]
}
if {[llength $rdma_legacy_cdc_sources] != 17 ||
    [llength $rdma_legacy_cdc_sinks] != 17} {
  error "Legacy CDC object counts are not 17: sources=[llength $rdma_legacy_cdc_sources] sinks=[llength $rdma_legacy_cdc_sinks]"
}

set rdma_check_channel [open $rdma_check_xdc w]
puts $rdma_check_channel "# Exact legacy GTYE4 DRP-to-ILA CDC waivers."
puts $rdma_check_channel "# Generated by check_legacy_debug_waiver_reload.tcl."
set rdma_legacy_drp_clock_name [get_property NAME $rdma_legacy_drp_clock_pin]
set rdma_legacy_drp_clock_lookup \
  [format {[get_pins -quiet %s]} [list $rdma_legacy_drp_clock_name]]
foreach rdma_legacy_cdc_sink $rdma_legacy_cdc_sinks {
  set rdma_legacy_cdc_sink_name [get_property NAME $rdma_legacy_cdc_sink]
  set rdma_legacy_cdc_sink_lookup \
    [format {[get_pins -quiet %s]} [list $rdma_legacy_cdc_sink_name]]
  puts $rdma_check_channel [format \
    {create_waiver -type CDC -id {CDC-1} -user {rdma_build} -tags {rdma_legacy_drp_debug} -desc {Legacy GTYE4 DRP status is sampled only by a txusrclk2 diagnostic ILA} -from %s -to %s} \
    $rdma_legacy_drp_clock_lookup $rdma_legacy_cdc_sink_lookup]
}
close $rdma_check_channel
close_design
} elseif {![file exists $rdma_check_xdc] || [file size $rdma_check_xdc] == 0} {
  error "Missing generated waiver check XDC: $rdma_check_xdc"
}

open_checkpoint $rdma_routed_checkpoint
set rdma_embedded_waivers [get_waivers -quiet -filter \
  {TYPE == CDC && ID == CDC-1 && TAGS =~ *rdma_legacy_drp_debug*}]
if {[llength $rdma_embedded_waivers] != 17} {
  error "Expected 17 embedded legacy CDC waivers, found [llength $rdma_embedded_waivers]"
}
delete_waivers $rdma_embedded_waivers
set rdma_remaining_waivers [get_waivers -quiet -filter \
  {TYPE == CDC && ID == CDC-1 && TAGS =~ *rdma_legacy_drp_debug*}]
if {[llength $rdma_remaining_waivers] != 0} {
  error "Legacy CDC waivers remain after deletion"
}
read_xdc $rdma_check_xdc
set rdma_reloaded_waivers [get_waivers -quiet -filter \
  {TYPE == CDC && ID == CDC-1 && TAGS =~ *rdma_legacy_drp_debug*}]
report_cdc -severity Critical -no_header -return_string
set rdma_unwaived_critical_cdc [get_cdc_violations -quiet -filter \
  {SEVERITY == Critical}]
puts "RDMA_CDC_WAIVER_RELOAD_CHECK waivers=[llength $rdma_reloaded_waivers] critical_unwaived=[llength $rdma_unwaived_critical_cdc]"
if {[llength $rdma_reloaded_waivers] != 17} {
  error "Expected 17 reloaded legacy CDC waivers, found [llength $rdma_reloaded_waivers]"
}
if {[llength $rdma_unwaived_critical_cdc] != 0} {
  error "Routed checkpoint retains unwaived Critical CDC paths"
}

close_design
exit
